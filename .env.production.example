POSTGRES_DB=wafi_os
POSTGRES_USER=wafi
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://wafi:replace-with-a-url-encoded-password@postgres:5432/wafi_os?schema=public

API_PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
CORS_ORIGINS=https://app.example.com
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
DOCUMENT_MAX_SIZE_BYTES=10000000
REDIS_URL=redis://redis:6379
WORKER_CONCURRENCY=5
BACKGROUND_JOBS_ENABLED=true
FAILED_JOB_ALERT_THRESHOLD=1
DOCUMENT_STORAGE_PROVIDER=s3
S3_REGION=me-central-1
S3_BUCKET=replace-with-private-document-bucket
S3_ENDPOINT=https://replace-with-s3-compatible-endpoint
S3_ACCESS_KEY_ID=replace-through-secret-management
S3_SECRET_ACCESS_KEY=replace-through-secret-management
S3_FORCE_PATH_STYLE=false
DOCUMENT_SIGNED_URL_TTL_SECONDS=300

# Backup automation runs outside application containers using secret-manager values.
BACKUP_DIRECTORY=/secure/wafi-backups
BACKUP_RETENTION_DAYS=35
