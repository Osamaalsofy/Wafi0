# Copy to .env for Docker Compose.
POSTGRES_DB=wafi_os
POSTGRES_USER=wafi
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
API_PORT=3001
WEB_PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://wafi:change-me-local-only@localhost:5432/wafi_os?schema=public
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
CORS_ORIGINS=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
DOCUMENT_STORAGE_LOCAL_PATH=./var/documents
DOCUMENT_MAX_SIZE_BYTES=10000000
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=5
BACKGROUND_JOBS_ENABLED=true
DOCUMENT_STORAGE_PROVIDER=local
S3_REGION=me-central-1
DOCUMENT_SIGNED_URL_TTL_SECONDS=300
BOOTSTRAP_ORGANIZATION_CODE=wafi
BOOTSTRAP_ORGANIZATION_NAME=WAFI
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Initial Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
