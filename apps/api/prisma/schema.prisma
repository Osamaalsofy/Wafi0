  publishedByUserId    String?         @map("published_by_user_id") @db.Uuid
  createdByUserId      String          @map("created_by_user_id") @db.Uuid
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  snapshot     KpiFactSnapshot    @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  publishedBy  User?              @relation("KpiResultPublisher", fields: [publishedByUserId], references: [id], onDelete: Restrict)
  createdBy    User               @relation("KpiResultCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  missions     KpiMissionResult[]

  @@unique([organizationId, snapshotId, periodType, calculationVersion])
  @@index([organizationId, periodType, periodStart, periodEnd, status])
  @@index([organizationId, publishedAt])
  @@map("kpi_results")
}

model KpiMissionResult {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  resultId         String   @map("result_id") @db.Uuid
  missionId        String   @map("mission_id") @db.Uuid
  clientId         String   @map("client_id") @db.Uuid
  carrierId        String?  @map("carrier_id") @db.Uuid
  driverId         String?  @map("driver_id") @db.Uuid
  score            Decimal? @db.Decimal(6, 2)
  applicableWeight Decimal  @map("applicable_weight") @db.Decimal(6, 2)
  targetMet        Boolean? @map("target_met")
  components       Json
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  result       KpiResult    @relation(fields: [resultId], references: [id], onDelete: Cascade)
  mission      Mission      @relation(fields: [missionId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([resultId, missionId])
  @@index([organizationId, clientId, createdAt])
  @@index([organizationId, carrierId, createdAt])
  @@index([organizationId, driverId, createdAt])
  @@map("kpi_mission_results")
}

model OperationalException {
  id                  String             @id @default(uuid()) @db.Uuid
  organizationId      String             @map("organization_id") @db.Uuid
  missionId           String             @map("mission_id") @db.Uuid
  stopId              String?            @map("stop_id") @db.Uuid
  ruleCode            String             @map("rule_code") @db.VarChar(120)
  ruleConfigurationId String?            @map("rule_configuration_id") @db.Uuid
  activeKey           String?            @unique @map("active_key") @db.VarChar(300)
  occurrenceKey       String             @map("occurrence_key") @db.VarChar(300)
  status              ExceptionStatus    @default(OPEN)
  severity            ExceptionSeverity?
  isBlocking          Boolean            @default(false) @map("is_blocking")
  ownerUserId         String?            @map("owner_user_id") @db.Uuid
  ownerScopeType      ScopeType?         @map("owner_scope_type")
  ownerScopeId        String?            @map("owner_scope_id") @db.Uuid
  clientId            String             @map("client_id") @db.Uuid
  routeId             String?            @map("route_id") @db.Uuid
  warehouseId         String             @map("warehouse_id") @db.Uuid
  carrierId           String?            @map("carrier_id") @db.Uuid
  vehicleId           String?            @map("vehicle_id") @db.Uuid
  driverId            String?            @map("driver_id") @db.Uuid
  scheduledAt         DateTime?          @map("scheduled_at") @db.Timestamptz(6)
  actualAt            DateTime?          @map("actual_at") @db.Timestamptz(6)
  delayMinutes        Int?               @map("delay_minutes")
  actualQuantity      Decimal?           @map("actual_quantity") @db.Decimal(14, 3)
  toleranceQuantity   Decimal?           @map("tolerance_quantity") @db.Decimal(14, 3)
  context             Json               @default("{}")
  openedAt            DateTime           @default(now()) @map("opened_at") @db.Timestamptz(6)
  lastDetectedAt      DateTime           @default(now()) @map("last_detected_at") @db.Timestamptz(6)
  resolvedAt          DateTime?          @map("resolved_at") @db.Timestamptz(6)
  resolutionNotes     String?            @map("resolution_notes") @db.VarChar(2000)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  mission           Mission             @relation(fields: [missionId], references: [id], onDelete: Restrict)
  stop              MissionStop?        @relation(fields: [stopId], references: [id], onDelete: Restrict)
  definition        RuleDefinition      @relation(fields: [ruleCode], references: [code], onDelete: Restrict)
  ruleConfiguration RuleConfiguration?  @relation(fields: [ruleConfigurationId], references: [id], onDelete: Restrict)
  route             OperationalRoute?   @relation(fields: [routeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  owner             User?               @relation("ExceptionOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  affectedStops     ExceptionStop[]
  rootCauses        RootCause[]
  decisions         Decision[]
  alerts            Alert[]
  evidence          ExceptionEvidence[]

  @@index([organizationId, status, severity])
  @@index([missionId, status])
  @@index([routeId, status])
  @@index([ruleCode, openedAt])
  @@index([ownerUserId, status])
  @@map("operational_exceptions")
}

model ExceptionStop {
  exceptionId String @map("exception_id") @db.Uuid
  stopId      String @map("stop_id") @db.Uuid

  exception OperationalException @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  stop      MissionStop          @relation(fields: [stopId], references: [id], onDelete: Restrict)

  @@id([exceptionId, stopId])
  @@map("exception_stops")
}

model ExceptionEvidence {
  exceptionId String   @map("exception_id") @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  purpose     String?  @db.VarChar(240)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  exception OperationalException @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  document  Document             @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@id([exceptionId, documentId])
  @@map("exception_evidence")
}

model RootCause {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  exceptionId       String    @map("exception_id") @db.Uuid
  category          String    @db.VarChar(120)
  categoryId        String?   @map("category_id") @db.Uuid
  description       String    @db.VarChar(2000)
  confirmedByUserId String?   @map("confirmed_by_user_id") @db.Uuid
  confirmedAt       DateTime? @map("confirmed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  exception    OperationalException @relation(fields: [exceptionId], references: [id], onDelete: Restrict)
  confirmedBy  User?                @relation("RootCauseConfirmer", fields: [confirmedByUserId], references: [id], onDelete: Restrict)
  taxonomy     RootCauseCategory?   @relation(fields: [categoryId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([exceptionId, createdAt])
  @@map("root_causes")
}

model RootCauseCategory {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String    @db.VarChar(120)
  nameEn         String    @map("name_en") @db.VarChar(160)
  nameAr         String    @map("name_ar") @db.VarChar(160)
  parentId       String?   @map("parent_id") @db.Uuid
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  retiredAt      DateTime? @map("retired_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent       RootCauseCategory?  @relation("RootCauseHierarchy", fields: [parentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  children     RootCauseCategory[] @relation("RootCauseHierarchy")
  rootCauses   RootCause[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, isActive])
  @@map("root_cause_categories")
}

model Decision {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  exceptionId     String   @map("exception_id") @db.Uuid
  decisionText    String   @map("decision_text") @db.VarChar(4000)
  decidedByUserId String   @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime @default(now()) @map("decided_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  exception    OperationalException @relation(fields: [exceptionId], references: [id], onDelete: Restrict)
  decidedBy    User                 @relation("DecisionMaker", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  actions      CorrectiveAction[]

  @@index([exceptionId, decidedAt])
  @@map("decisions")
}

model CorrectiveAction {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  decisionId        String       @map("decision_id") @db.Uuid
  ownerUserId       String       @map("owner_user_id") @db.Uuid
  actionText        String       @map("action_text") @db.VarChar(4000)
  dueAt             DateTime?    @map("due_at") @db.Timestamptz(6)
  status            ActionStatus @default(OPEN)
  completedAt       DateTime?    @map("completed_at") @db.Timestamptz(6)
  completedByUserId String?      @map("completed_by_user_id") @db.Uuid
  completionNotes   String?      @map("completion_notes") @db.VarChar(2000)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  decision     Decision     @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  owner        User         @relation("ActionOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  completedBy  User?        @relation("ActionCompleter", fields: [completedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, dueAt])
  @@index([decisionId, status])
  @@map("corrective_actions")
}

model Alert {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  exceptionId     String      @map("exception_id") @db.Uuid
  userId          String?     @map("user_id") @db.Uuid
  channel         String      @default("IN_APP") @db.VarChar(40)
  status          AlertStatus @default(PENDING)
  sentAt          DateTime?   @map("sent_at") @db.Timestamptz(6)
  readAt          DateTime?   @map("read_at") @db.Timestamptz(6)
  escalationDueAt DateTime    @map("escalation_due_at") @db.Timestamptz(6)
  escalatedAt     DateTime?   @map("escalated_at") @db.Timestamptz(6)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  exception        OperationalException   @relation(fields: [exceptionId], references: [id], onDelete: Restrict)
  user             User?                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  deliveryAttempts AlertDeliveryAttempt[]
  escalations      AlertEscalation[]

  @@index([organizationId, status, createdAt])
  @@index([userId, status])
  @@index([organizationId, escalationDueAt, escalatedAt])
  @@map("alerts")
}

model AlertDeliveryAttempt {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  alertId        String               @map("alert_id") @db.Uuid
  attemptNo      Int                  @map("attempt_no")
  channel        String               @default("EMAIL") @db.VarChar(40)
  outcome        AlertDeliveryOutcome
  attemptedAt    DateTime             @map("attempted_at") @db.Timestamptz(6)
  error          String?              @db.VarChar(2000)
  nextAttemptAt  DateTime?            @map("next_attempt_at") @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  alert        Alert        @relation(fields: [alertId], references: [id], onDelete: Restrict)

  @@unique([alertId, attemptNo])
  @@index([organizationId, nextAttemptAt])
  @@map("alert_delivery_attempts")
}

model AlertEscalation {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  alertId         String   @map("alert_id") @db.Uuid
  recipientUserId String   @map("recipient_user_id") @db.Uuid
  escalatedAt     DateTime @map("escalated_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  alert        Alert        @relation(fields: [alertId], references: [id], onDelete: Restrict)
  recipient    User         @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)

  @@unique([alertId, recipientUserId])
  @@index([organizationId, escalatedAt])
  @@map("alert_escalations")
}

model ClosureDocumentRequirement {
  id           String                   @id @default(uuid()) @db.Uuid
  policyId     String                   @map("policy_id") @db.Uuid
  documentType DocumentType             @map("document_type")
  scope        DocumentRequirementScope
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  policy ClosurePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, documentType, scope])
  @@map("closure_document_requirements")
}
