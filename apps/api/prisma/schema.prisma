generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum GeofenceType {
  POINT
  POLYGON
  MULTIPOLYGON
}

model Country {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.Char(2)
  nameAr    String   @map("name_ar") @db.VarChar(120)
  nameEn    String   @map("name_en") @db.VarChar(120)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  regions GeographicRegion[]

  @@index([isActive])
  @@map("countries")
}

model GeographicRegion {
  id        String   @id @default(uuid()) @db.Uuid
  countryId String   @map("country_id") @db.Uuid
  code      String   @unique @db.VarChar(32)
  nameAr    String   @map("name_ar") @db.VarChar(160)
  nameEn    String   @map("name_en") @db.VarChar(160)
  latitude  Decimal  @db.Decimal(9, 6)
  longitude Decimal  @db.Decimal(9, 6)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  country      Country       @relation(fields: [countryId], references: [id], onDelete: Restrict)
  governorates Governorate[]

  @@index([countryId, isActive])
  @@index([nameAr])
  @@index([nameEn])
  @@map("geographic_regions")
}

model Governorate {
  id               String       @id @default(uuid()) @db.Uuid
  regionId         String       @map("region_id") @db.Uuid
  code             String       @unique @db.VarChar(80)
  nameAr           String       @map("name_ar") @db.VarChar(160)
  nameEn           String       @map("name_en") @db.VarChar(160)
  latitude         Decimal      @db.Decimal(9, 6)
  longitude        Decimal      @db.Decimal(9, 6)
  timezone         String       @default("Asia/Riyadh") @db.VarChar(80)
  geofenceType     GeofenceType @default(POINT) @map("geofence_type")
  geofence         Json?
  coordinateSource String       @map("coordinate_source") @db.VarChar(120)
  isMajor          Boolean      @default(false) @map("is_major")
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  region     GeographicRegion @relation(fields: [regionId], references: [id], onDelete: Restrict)
  warehouses Warehouse[]
  branches   Branch[]

  @@index([regionId, isActive])
  @@index([nameAr])
  @@index([nameEn])
  @@index([isActive, isMajor])
  @@map("governorates")
}

enum ScopeType {
  ORGANIZATION
  CLIENT
  CARRIER
  WAREHOUSE
  BRANCH
}

enum MissionStatus {
  DRAFT
  ASSIGNED
  WAITING_FOR_VEHICLE
  VEHICLE_ARRIVED
  LOADING
  LOADED
  DEPARTED
  IN_TRANSIT
  AT_STOP
  DELIVERING
  DELIVERED
  OPERATIONALLY_CLOSED
  ACCOUNTING_READY
  CLOSED
  CANCELLED
}

enum MissionStopStatus {
  PENDING
  ARRIVED
  UNLOADING
  COMPLETED
  CANCELLED
}

enum DocumentType {
  WAYBILL
  GATE_PASS
  POD
  RECEIVER_SIGNATURE
  RECEIVER_STAMP
  SHORTAGE_PROOF
  RETURN_PROOF
  OTHER
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum MalwareScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum ClosureStage {
  OPERATIONAL_CLOSURE
  ACCOUNTING_READINESS
}

enum ClosurePolicyStatus {
  DRAFT
  APPROVED
  ACTIVE
  RETIRED
}

enum DocumentRequirementScope {
  MISSION
  EACH_STOP
}

enum RuleScopeType {
  ORGANIZATION
  CLIENT
  WAREHOUSE
  CARRIER
  CONTRACT
  ROUTE
  DRIVER
}

enum ExceptionSeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

enum ExceptionStatus {
  OPEN
  RESOLVED
}

enum ActionStatus {
  OPEN
  COMPLETED
}

enum AlertStatus {
  PENDING
  SENT
  READ
  FAILED
}

enum AlertDeliveryOutcome {
  SENT
  FAILED
}

enum KpiResultStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum KpiPeriodType {
  DAILY
  WEEKLY
  MONTHLY
}

enum ContractCadence {
  DAILY
  WEEKLY
  MONTHLY
  ANNUAL
}

enum ContractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  EXPIRED
  TERMINATED
}

enum QuantityUnit {
  UNIT
  KG
  TON
  LITER
  PALLET
  CARTON
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum MissionAssignmentKind {
  INITIAL
  DRIVER_REPLACEMENT
  VEHICLE_REPLACEMENT
  REASSIGNMENT
}

enum ContractPartyType {
  ORGANIZATION
  CLIENT
  CARRIER
  DRIVER
}

model Organization {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique @db.VarChar(64)
  name      String       @db.VarChar(160)
  status    RecordStatus @default(ACTIVE)
  settings  Json         @default("{}")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  users                 User[]
  roles                 Role[]
  auditLogs             AuditLog[]
  clients               Client[]
  carriers              Carrier[]
  missions              Mission[]
  missionStops          MissionStop[]
  missionEvents         MissionEvent[]
  documents             Document[]
  closurePolicies       ClosurePolicy[]
  ruleConfigurations    RuleConfiguration[]
  kpiConfigurations     KpiConfiguration[]
  kpiFactSnapshots      KpiFactSnapshot[]
  kpiMissionFacts       KpiMissionFact[]
  kpiResults            KpiResult[]
  kpiMissionResults     KpiMissionResult[]
  exceptions            OperationalException[]
  rootCauses            RootCause[]
  decisions             Decision[]
  actions               CorrectiveAction[]
  alerts                Alert[]
  alertDeliveryAttempts AlertDeliveryAttempt[]
  alertEscalations      AlertEscalation[]
  contracts             OperationalContract[]
  routes                OperationalRoute[]
  rootCauseCategories   RootCauseCategory[]
  missionAssignments    MissionAssignment[]
  supportTickets        SupportTicket[]
  notifications         PortalNotification[]

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  email          String       @db.VarChar(254)
  name           String       @db.VarChar(160)
  passwordHash   String       @map("password_hash")
  status         RecordStatus @default(ACTIVE)
  lastLoginAt    DateTime?    @map("last_login_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization               Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roleAssignments            UserRole[]
  refreshSessions            RefreshSession[]
  auditLogs                  AuditLog[]             @relation("AuditActor")
  missionEvents              MissionEvent[]         @relation("MissionEventActor")
  uploadedDocuments          Document[]             @relation("DocumentUploader")
  verifiedDocuments          Document[]             @relation("DocumentVerifier")
  activatedClosurePolicies   ClosurePolicy[]
  authoredClosurePolicies    ClosurePolicy[]        @relation("ClosurePolicyAuthor")
  approvedClosurePolicies    ClosurePolicy[]        @relation("ClosurePolicyApprover")
  createdRuleConfigurations  RuleConfiguration[]    @relation("RuleConfigurationCreator")
  createdKpiConfigurations   KpiConfiguration[]     @relation("KpiConfigurationCreator")
  createdKpiFactSnapshots    KpiFactSnapshot[]      @relation("KpiFactSnapshotCreator")
  createdKpiResults          KpiResult[]            @relation("KpiResultCreator")
  publishedKpiResults        KpiResult[]            @relation("KpiResultPublisher")
  ownedRuleConfigurations    RuleConfiguration[]    @relation("RuleConfigurationOwner")
  ownedExceptions            OperationalException[] @relation("ExceptionOwner")
  confirmedRootCauses        RootCause[]            @relation("RootCauseConfirmer")
  madeDecisions              Decision[]             @relation("DecisionMaker")
  ownedActions               CorrectiveAction[]     @relation("ActionOwner")
  completedActions           CorrectiveAction[]     @relation("ActionCompleter")
  alerts                     Alert[]
  alertEscalations           AlertEscalation[]
  createdContracts           OperationalContract[]
  createdRoutes              OperationalRoute[]
  driver                     Driver?
  supportMessages            SupportMessage[]
  assignedSupportTickets     SupportTicket[]        @relation("SupportTicketAssignee")
  supportAssignmentsMade     SupportAssignment[]    @relation("SupportAssignmentActor")
  supportAssignmentsReceived SupportAssignment[]    @relation("SupportAssignmentAssignee")
  portalNotifications        PortalNotification[]

  @@unique([organizationId, email])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@map("users")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(80)
  name           String   @db.VarChar(120)
  description    String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions  RolePermission[]
  assignments  UserRole[]

  @@unique([organizationId, code])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(120)
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  scopeType ScopeType @map("scope_type")
  scopeId   String    @map("scope_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scopeType, scopeId])
  @@index([userId, scopeType, scopeId])
  @@map("user_roles")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_sessions")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  entityType     String   @map("entity_type") @db.VarChar(80)
  entityId       String   @map("entity_id") @db.Uuid
  action         String   @db.VarChar(120)
  oldValues      Json?    @map("old_values")
  newValues      Json?    @map("new_values")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Client {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  code           String       @db.VarChar(64)
  name           String       @db.VarChar(160)
  status         RecordStatus @default(ACTIVE)
  settings       Json         @default("{}")
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouses      Warehouse[]
  drivers         Driver[]
  branches        Branch[]
  missions        Mission[]
  closurePolicies ClosurePolicy[]
  routes          OperationalRoute[]
  supportTickets  SupportTicket[]
  notifications   PortalNotification[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, name])
  @@map("clients")
}

model OperationalContract {
  id                            String          @id @default(uuid()) @db.Uuid
  organizationId                String          @map("organization_id") @db.Uuid
  code                          String          @db.VarChar(80)
  name                          String          @db.VarChar(160)
  cadence                       ContractCadence
  status                        ContractStatus  @default(DRAFT)
  effectiveFrom                 DateTime        @map("effective_from") @db.Timestamptz(6)
  effectiveTo                   DateTime        @map("effective_to") @db.Timestamptz(6)
  createdByUserId               String          @map("created_by_user_id") @db.Uuid
  createdAt                     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  temperatureMonitoringRequired Boolean         @default(false) @map("temperature_monitoring_required")
  minimumTemperature            Decimal?        @map("minimum_temperature") @db.Decimal(7, 2)
  maximumTemperature            Decimal?        @map("maximum_temperature") @db.Decimal(7, 2)
  temperatureGraceMinutes       Int?            @map("temperature_grace_minutes")
  temperatureSensorReference    String?         @map("temperature_sensor_reference") @db.VarChar(160)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User            @relation(fields: [createdByUserId, organizationId], references: [id, organizationId], onDelete: Restrict)
  parties      ContractParty[]
  missions     Mission[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, status, effectiveFrom, effectiveTo])
  @@map("operational_contracts")
}

model ContractParty {
  id             String            @id @default(uuid()) @db.Uuid
  contractId     String            @map("contract_id") @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  partyType      ContractPartyType @map("party_type")
  partyId        String            @map("party_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  contract OperationalContract @relation(fields: [contractId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([contractId, partyType, partyId])
  @@index([organizationId, partyType, partyId])
  @@map("contract_parties")
}

model OperationalRoute {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  clientId        String       @map("client_id") @db.Uuid
  code            String       @db.VarChar(80)
  name            String       @db.VarChar(160)
  cityRegion      String       @map("city_region") @db.VarChar(160)
  timeZone        String       @map("time_zone") @db.VarChar(80)
  status          RecordStatus @default(ACTIVE)
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client       Client                 @relation(fields: [clientId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy    User                   @relation(fields: [createdByUserId, organizationId], references: [id, organizationId], onDelete: Restrict)
  stops        RouteStop[]
  missions     Mission[]
  exceptions   OperationalException[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([clientId, status])
  @@map("operational_routes")
}

model RouteStop {
  id             String   @id @default(uuid()) @db.Uuid
  routeId        String   @map("route_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  sequence       Int
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  route  OperationalRoute @relation(fields: [routeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  branch Branch           @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([routeId, sequence])
  @@index([organizationId, branchId])
  @@map("route_stops")
}

model Carrier {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  code           String       @db.VarChar(64)
  name           String       @db.VarChar(160)
  status         RecordStatus @default(ACTIVE)
  settings       Json         @default("{}")
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  drivers      Driver[]
  vehicles     Vehicle[]
  missions     Mission[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, name])
  @@map("carriers")
}

model Warehouse {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  clientId       String       @map("client_id") @db.Uuid
  code           String       @db.VarChar(64)
  name           String       @db.VarChar(160)
  address        String?
  latitude       Decimal?     @db.Decimal(9, 6)
  longitude      Decimal?     @db.Decimal(9, 6)
  governorateId  String?      @map("governorate_id") @db.Uuid
  status         RecordStatus @default(ACTIVE)
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  client      Client       @relation(fields: [clientId, organizationId], references: [id, organizationId], onDelete: Restrict)
  governorate Governorate? @relation(fields: [governorateId], references: [id], onDelete: Restrict)
  missions    Mission[]

  @@unique([clientId, code])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([clientId, status])
  @@index([governorateId])
  @@map("warehouses")
}

model Branch {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  clientId       String       @map("client_id") @db.Uuid
  code           String       @db.VarChar(64)
  name           String       @db.VarChar(160)
  address        String?
  latitude       Decimal?     @db.Decimal(9, 6)
  longitude      Decimal?     @db.Decimal(9, 6)
  governorateId  String?      @map("governorate_id") @db.Uuid
  status         RecordStatus @default(ACTIVE)
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  client       Client        @relation(fields: [clientId, organizationId], references: [id, organizationId], onDelete: Restrict)
  governorate  Governorate?  @relation(fields: [governorateId], references: [id], onDelete: Restrict)
  missionStops MissionStop[]
  routeStops   RouteStop[]

  @@unique([clientId, code])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([clientId, status])
  @@index([governorateId])
  @@map("branches")
}

model Driver {
  id                     String       @id @default(uuid()) @db.Uuid
  organizationId         String       @map("organization_id") @db.Uuid
  userId                 String?      @unique @map("user_id") @db.Uuid
  carrierId              String       @map("carrier_id") @db.Uuid
  clientId               String?      @map("client_id") @db.Uuid
  trackingNumber         String?      @map("tracking_number") @db.VarChar(80)
  nationalId             String?      @map("national_id") @db.VarChar(20)
  profilePhotoDocumentId String?      @map("profile_photo_document_id") @db.Uuid
  name                   String       @db.VarChar(160)
  phone                  String?      @db.VarChar(32)
  licenseNo              String?      @map("license_no") @db.VarChar(80)
  status                 RecordStatus @default(ACTIVE)
  archivedAt             DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  carrier           Carrier             @relation(fields: [carrierId, organizationId], references: [id, organizationId], onDelete: Restrict)
  client            Client?             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  user              User?               @relation(fields: [userId], references: [id], onDelete: Restrict)
  missions          Mission[]
  assignmentHistory MissionAssignment[]
  supportTickets    SupportTicket[]

  @@unique([carrierId, licenseNo])
  @@unique([organizationId, trackingNumber])
  @@unique([organizationId, nationalId])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([carrierId, status])
  @@index([clientId, status])
  @@index([organizationId, name])
  @@map("drivers")
}

model Vehicle {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  carrierId      String       @map("carrier_id") @db.Uuid
  plateNo        String       @map("plate_no") @db.VarChar(40)
  vehicleType    String?      @map("vehicle_type") @db.VarChar(80)
  capacity       Decimal?     @db.Decimal(14, 3)
  capacityUnit   String?      @map("capacity_unit") @db.VarChar(32)
  status         RecordStatus @default(ACTIVE)
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  carrier           Carrier             @relation(fields: [carrierId, organizationId], references: [id, organizationId], onDelete: Restrict)
  missions          Mission[]
  assignmentHistory MissionAssignment[]

  @@unique([carrierId, plateNo])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([carrierId, status])
  @@index([organizationId, plateNo])
  @@map("vehicles")
}

model Mission {
  id                   String        @id @default(uuid()) @db.Uuid
  organizationId       String        @map("organization_id") @db.Uuid
  missionNo            String        @map("mission_no") @db.VarChar(80)
  clientId             String        @map("client_id") @db.Uuid
  contractId           String?       @map("contract_id") @db.Uuid
  routeId              String?       @map("route_id") @db.Uuid
  warehouseId          String        @map("warehouse_id") @db.Uuid
  carrierId            String?       @map("carrier_id") @db.Uuid
  vehicleId            String?       @map("vehicle_id") @db.Uuid
