{
  "name": "@wafi/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "worker": "node dist/src/worker.js",
    "worker:dev": "nest start --entryFile worker --watch",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json --runInBand",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-integration.json --runInBand",
    "bootstrap:identity": "nest build && node dist/scripts/bootstrap-identity.js",
    "geography:seed": "nest build && node dist/scripts/seed-geography.js",
    "geography:validate": "nest build && node dist/scripts/validate-geography.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@aws-sdk/s3-request-presigner": "^3.1108.0",
    "@nestjs/common": "latest",
    "@nestjs/config": "latest",
    "@nestjs/core": "latest",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "latest",
    "@nestjs/swagger": "latest",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "latest",
    "@prisma/client": "latest",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.1.0",
    "class-transformer": "latest",
    "class-validator": "latest",
    "dotenv": "latest",
    "helmet": "latest",
    "ioredis": "^6.0.0",
    "pg": "latest",
    "reflect-metadata": "latest",
    "rxjs": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@nestjs/cli": "latest",
    "@nestjs/schematics": "latest",
    "@nestjs/testing": "latest",
    "@types/express": "latest",
    "@types/jest": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/supertest": "latest",
    "eslint": "9.39.2",
    "eslint-config-prettier": "latest",
    "globals": "latest",
    "jest": "latest",
    "prisma": "7.9.1",
    "source-map-support": "latest",
    "supertest": "latest",
    "ts-jest": "latest",
    "ts-node": "latest",
    "typescript": "6.0.2",
    "typescript-eslint": "latest"
  }
}
